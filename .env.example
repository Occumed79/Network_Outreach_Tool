# Operational outreach database
DATABASE_URL=

# Research / AI working database
DATABASE_URL_2=

# Optional existing-system adapters
NETWORK_MAP_API_URL=
INTERNATIONAL_SEARCH_API_URL=
AGREEMENT_GENERATOR_URL=

# Optional web research providers
# Order is configurable; every configured source in the list is queried.
RESEARCH_SEARCH_PROVIDERS=tavily,exa
TAVILY_API_KEY=
EXA_API_KEY=

# Optional AI research router
# Neon AI Gateway is preferred when configured. A generic OpenAI-compatible
# endpoint can be used instead. Keep all tokens in runtime secrets only.
NEON_AI_GATEWAY_BASE_URL=
NEON_AI_GATEWAY_TOKEN=
OPENAI_COMPAT_BASE_URL=
OPENAI_COMPAT_API_KEY=
AI_RESEARCH_MODEL=

# Reserved future research adapters
KEENABLE_API_KEY=
TINYFISH_API_KEY=

# Runtime
PORT=8787
WEB_ORIGIN=http://localhost:5173
